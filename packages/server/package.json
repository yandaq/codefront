{
  "name": "@grim-repo/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/dev.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@grim-repo/core": "workspace:*",
    "@grim-repo/schema": "workspace:*",
    "@grim-repo/web": "workspace:*",
    "fastify": "^5.1.0",
    "chokidar": "^4.0.1"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
