{
  "name": "grim-repo-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "dev:web": "pnpm --filter @grim-repo/web dev",
    "dev:server": "pnpm --filter @grim-repo/server dev",
    "start": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "volta": {
    "node": "22.21.1"
  },
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "keytar"
    ]
  }
}
